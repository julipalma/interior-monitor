SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Opcional: peticiones HTML concurrentes (badge / JSON-LD)
# FETCH_CONCURRENCY=3
# Máx. URLs a abrir por medio cuando hay que leer la nota (orden por fecha)
# MAX_DEEP_INSPECT=400
# CSV de frecuencia de tags (por defecto data/frecuencia_tags_unificado.csv)
# TAGS_CSV_PATH=/ruta/al/frecuencia_tags_unificado.csv
# Alineación semántica (lexical + peso log1p(cantidad)); desactivar: SEMANTIC_DISABLE=1
# SEMANTIC_MIN_SIMILARITY=0.5
# SEMANTIC_TOP_MATCHES=5
# SEMANTIC_GENERIC_MULTIPLIER=0.4
# SEMANTIC_GENERIC_TAGS=muerte,policia,accidente,investigacion
# Gate para enviar a Slack/TXT (si hay lexicón): requiere match y score mínimo
# SEMANTIC_REQUIRE_MATCH=1
# SEMANTIC_MIN_INTEREST_SCORE=1.2
# Si está en 1: solo deja pasar notas con al menos un tag sim=1.00
# SEMANTIC_ONLY_SIM_ONE=1
# Modo: lexical (default) o hybrid (embeddings + LLM)
# SEMANTIC_MODE=hybrid
# OPENAI_API_KEY=<tu_api_key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
# SEMANTIC_LLM_MODEL=gpt-4o-mini
# SEMANTIC_EMBED_TOP_K=12
# SEMANTIC_EMBED_MIN_SIMILARITY=0.2
# Health monitoring de fuentes
# HEALTH_STREAK_THRESHOLD=3
# SLACK_HEALTH_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Enviar health a Slack solo cuando haya warning/critical (default 1)
# HEALTH_NOTIFY_ONLY_ON_ALERT=1
# Umbrales warning
# HEALTH_WARN_FAILED_PERCENT=15
# HEALTH_WARN_403_PER_DOMAIN=2
# HEALTH_WARN_STREAK=2
# Umbrales críticos
# HEALTH_CRIT_FAILED_PERCENT=30
# HEALTH_CRIT_403_PER_DOMAIN=5
# HEALTH_CRIT_STREAK=4
